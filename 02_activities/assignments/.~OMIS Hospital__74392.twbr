    <worksheet name='D2: Comp/Readmit Across MD Groups'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='12'>Comparing Complications and Readmission Rates Across MD Groups</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Clinical Data+ (OMIS 5150 Hospital Final Kiran for Project)' name='federated.1wry5fb1vq2sfy10dk8gm0b0oqos' />
          </datasources>
          <datasource-dependencies datasource='federated.1wry5fb1vq2sfy10dk8gm0b0oqos'>
            <column caption='Readmission rate ' datatype='integer' name='[Calculation_1312940092671782912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Readmission Flag] = 1 THEN 1 ELSE 0 END' />
            </column>
            <column datatype='date' name='[Discharge Date]' role='dimension' type='ordinal' />
            <column caption='Attending Medical Group' datatype='string' name='[Group]' role='dimension' type='nominal' />

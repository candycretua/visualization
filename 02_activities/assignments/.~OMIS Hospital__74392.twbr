      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Clinical Data+ (OMIS 5150 Hospital Final Kiran for Project)' name='federated.1wry5fb1vq2sfy10dk8gm0b0oqos' />
          </datasources>
          <datasource-dependencies datasource='federated.1wry5fb1vq2sfy10dk8gm0b0oqos'>
            <column datatype='integer' name='[LOS (Days)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Patient Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Payor Group]' role='dimension' type='nominal' />
            <column-instance column='[LOS (Days)]' derivation='Avg' name='[avg:LOS (Days):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Patient Type]' derivation='None' name='[none:Patient Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Payor Group]' derivation='None' name='[none:Payor Group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Patient Type:nk]' direction='ASC'>

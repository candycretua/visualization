    <worksheet name='D1: Top 10 Admission Sources'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='12'>Top 10 Admission Sources &amp; Location</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Clinical Data+ (OMIS 5150 Hospital Final Kiran for Project)' name='federated.1wry5fb1vq2sfy10dk8gm0b0oqos' />
          </datasources>
          <datasource-dependencies datasource='federated.1wry5fb1vq2sfy10dk8gm0b0oqos'>
            <column datatype='string' name='[Admit Source (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Admit Source]' new-bin='true'>
                <bin default-name='true' value='&quot;Direct Admit-Routine (Unsched), Referred By Physician, Trans From Another Facility and 4 more&quot;'>
                  <value>&quot;Direct Admit-Routine (Unsched)&quot;</value>
                  <value>&quot;Referred By Physician&quot;</value>
                  <value>&quot;Trans From Another Facility&quot;</value>
                  <value>&quot;Trans From Another Hospital&quot;</value>
                  <value>&quot;Trans From Skill Nurse Facilit&quot;</value>
                  <value>&quot;Trans-Psychiatric Facility&quot;</value>
                  <value>&quot;Trans-Terminal Care Fac.Or Hos&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[Admit Source]' role='dimension' type='nominal' />
            <column datatype='integer' name='[LOS (Days)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Location]' role='dimension' type='nominal' />
            <column datatype='real' name='[Total Charges]' role='measure' type='quantitative' />
            <column-instance column='[LOS (Days)]' derivation='Avg' name='[avg:LOS (Days):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Location]' derivation='None' name='[none:Location:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total Charges]' derivation='Sum' name='[sum:Total Charges:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[Admit Source (group)]'>
            <groupfilter function='level-members' level='[Admit Source (group)]' />
          </filter>
          <filter class='categorical' column='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Total Charges])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Location:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Acute Medical Care&quot;</bucket>
              <bucket>&quot;Cardiac Care&quot;</bucket>
              <bucket>&quot;Surgical Care&quot;</bucket>
              <bucket>&quot;Cardiac Surgical Care&quot;</bucket>
              <bucket>&quot;Orthopedic Care&quot;</bucket>
              <bucket>&quot;Oncology&quot;</bucket>
              <bucket>&quot;Stroke Care&quot;</bucket>
              <bucket>&quot;Mother Baby&quot;</bucket>
              <bucket>&quot;Trauma ICU&quot;</bucket>
              <bucket>&quot;Cardiac ICU&quot;</bucket>
              <bucket>&quot;Medical ICU&quot;</bucket>
              <bucket>&quot;Surgical ICU&quot;</bucket>
              <bucket>&quot;General Overflow&quot;</bucket>
              <bucket>&quot;Mother Baby Overflow&quot;</bucket>
              <bucket>&quot;Pediatric ICU&quot;</bucket>
              <bucket>&quot;Holding&quot;</bucket>
              <bucket>&quot;Cath Lab&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[Admit Source (group)]</column>
            <column>[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='total-label' data-class='total' field='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]' value='Grand Total' />
            <format attr='text-orientation' data-class='total' field='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]' value='-90' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[avg:LOS (Days):qk]' value='N' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[avg:LOS (Days):qk]' palette='green_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='legend-title-text'>
            <format attr='color' field='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[avg:LOS (Days):qk]' value='Average Length of Stay (Days)'>
              <formatted-text>
                <run bold='true' fontalignment='1' fontname='Arial'>Average Length of Stay (Days)</run>
              </formatted-text>
            </format>
          </style-rule>
        </style>
        <panes>
          <pane id='4' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[avg:LOS (Days):qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[sum:Total Charges:qk]</rows>
        <cols>[federated.1wry5fb1vq2sfy10dk8gm0b0oqos].[none:Location:nk]</cols>
